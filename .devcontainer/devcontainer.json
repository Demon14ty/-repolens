{
  "name": "RepoLens",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt && npm --prefix frontend install",
  "postAttachCommand": {
    "api": "python3 -m uvicorn api.index:app --reload --port 8000",
    "web": "npm --prefix frontend run dev"
  },
  "portsAttributes": {
    "3000": {
      "label": "RepoLens web",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "RepoLens API"
    }
  },
  "forwardPorts": [
    3000,
    8000
  ]
}
