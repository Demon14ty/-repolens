# Copy this file to .env and fill in what you need. Never commit .env.

# Optional. Public repositories work without it, but GitHub then allows only
# 60 API requests per hour. A token (no scopes needed for public repos) raises
# that to 5,000. Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. Enables AI-written explanations on top of RepoLens's built-in
# analysis. Without it, everything still works using deterministic text.
# (LLM_API_KEY is accepted as an alias.)
ANTHROPIC_API_KEY=

# Optional. Override the Claude model used for explanations.
# REPOLENS_MODEL=claude-opus-5
