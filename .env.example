# Copy this file to .env and fill in what you need. Never commit .env.
# On Vercel, set these in Project Settings -> Environment Variables instead.
# None of these values are ever sent to the browser.

# Optional. Public repositories work without it, but GitHub then allows only
# 60 API requests per hour (shared by everyone using the server). A token
# (no scopes needed for public repos) raises that to 5,000.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. Enables the "Explain in plain language" AI layer on top of
# RepoLens's built-in analysis. Without it, everything still works.
# (LLM_API_KEY is accepted as an alias.)
ANTHROPIC_API_KEY=

# Optional. Override the Claude model used for explanations.
# REPOLENS_MODEL=claude-opus-5

# Optional. Comma-separated origins allowed to call the API from another
# domain (CORS). Not needed on Vercel, where the frontend and API share a
# domain. Locally, http://localhost:3000 is allowed by default.
# FRONTEND_ORIGIN=http://localhost:3000
