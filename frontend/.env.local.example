# Copy to .env.local for local development.
#
# Where the browser sends API requests. Leave it empty in production on Vercel:
# the frontend and the API share one domain, so relative /api/... paths are used.
# During `npm run dev` an empty value falls back to http://localhost:8000.
#
# Only public, non-secret values may use the NEXT_PUBLIC_ prefix - it is bundled
# into browser JavaScript. Never put GITHUB_TOKEN or an LLM key here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
